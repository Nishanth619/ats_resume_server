rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Profile photos: users can read/write only their own
    match /users/{uid}/profile.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024   // max 5 MB
                   && request.resource.contentType.matches('image/.*');
    }

    // Resume PDFs: users can read/write only their own
    match /resumes/{uid}/{resumeId} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024; // max 10 MB
    }

    // Block everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
